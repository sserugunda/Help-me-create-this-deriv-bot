# Deriv
DERIV_APP_ID=
DERIV_API_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional fixed chat to receive notifications
TELEGRAM_CHAT_ID=

# Strategy
# Comma separated symbols override (optional). Default is 13 volatility indices.
SYMBOLS=
# Stake percent of balance per trade (1 = 1%)
STAKE_PCT=1
# Candle timeframe in seconds (60 only supported)
GRANULARITY=60
# Indicator percentage step (1 = 1%)
PERC_STEP=1
# Minimum samples for probabilities
MIN_SAMPLES=1
