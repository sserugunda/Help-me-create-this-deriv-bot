# Copy this to .env and fill values
DERIV_APP_ID=YOUR_APP_ID
DERIV_API_TOKEN=YOUR_LONG_SECRET_TOKEN
STAKE_AMOUNT=0.5
# Optional tuning
RSI_UPPER=55
RSI_LOWER=45
EMA_PERIOD=50
RSI_PERIOD=2
ENTRY_SECOND_THRESHOLD=58
TRADE_DURATION_SECONDS=55
MAX_SYMBOLS=13
SYMBOLS_CSV=1HZ10V,R10,1HZ15V,R25,1HZ25V,1HZ30V,1HZ50V,R50,1HZ75V,R75,1HZ90V,1HZ100V,R100

# Optional higher timeframe filter
HTF_ENABLED=false
# 3600 = 1h, 14400 = 4h
HTF_GRANULARITY=3600
# ema or color
HTF_FILTER=ema
HTF_EMA_PERIOD=50
HTF_RSI_PERIOD=14
